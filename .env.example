# Copy this file to .env and fill in the provider block you want to use.
# ONECODE_PROVIDER_ID selects the active provider. Provider settings are
# read only from that provider's block.

ONECODE_PROVIDER_ID=deepseek
ONECODE_TIMEOUT_SECONDS=60
ONECODE_EXTRA_HEADERS={}
ONECODE_DEFAULT_PARAMS={}

#openai
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=
OPENAI_API_KEY=

#deepseek
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_API_KEY=

#glm
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=
GLM_API_KEY=

#minimax
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_MODEL=
MINIMAX_API_KEY=

#siliconflow
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_MODEL=
SILICONFLOW_API_KEY=

#gemini
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_MODEL=
GEMINI_API_KEY=

#ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

#custom
CUSTOM_BASE_URL=
CUSTOM_MODEL=
CUSTOM_API_KEY=
