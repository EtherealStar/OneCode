# OneCode 配置
# 复制此文件为 .env 并填入你的实际值

# API Key（必填）
ONECODE_API_KEY=your-api-key-here

# Chat Completions 协议服务地址（必填）
# 填你自己的服务器地址；OneCode 不默认指向任何公网模型服务
ONECODE_BASE_URL=https://your-chat-completions-server

# 模型名称（必填）
ONECODE_MODEL=your-model-name

# 上下文窗口大小（可选，默认 200000）
# ONECODE_CONTEXT_WINDOW=200000

# 最大输出 token 数（可选，默认 8000）
# ONECODE_MAX_OUTPUT_TOKENS=8000
